# Copy to .env and fill in. Never commit .env (it's git-ignored).

# Option A - automatic setup (scripts/setup_supabase.py fills in the rest):
#   token: https://supabase.com/dashboard/account/tokens
#   ref:   the 'xxxx' in https://xxxx.supabase.co (Project Settings -> General -> Project ID)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Option B - manual: Project Settings -> API Keys (service_role key bypasses RLS; keep it secret)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
